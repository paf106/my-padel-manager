# Supabase Postgres connection string (Transaction pooler recommended).
# Get it from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Transaction" pooler URI and keep prepare:false in lib/db/index.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Basic auth (single user). Change these before deploying.
AUTH_USERNAME="admin"
AUTH_PASSWORD="cambia-esta-contraseña"
# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"
